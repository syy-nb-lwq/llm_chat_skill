# 环境变量
.env
.env.*
# 任何以 .env 结尾的文件（如 config/minimax.env）—— `.env.*` 挡不住这种命名
*.env
# 但模板必须能入库，否则新克隆的人不知道要配哪些键
!.env.example
# 其它凭据
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
credentials.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/

# Streamlit
.streamlit/

# 运行时生成的文件
uploads/
outputs/
vector_store/
# ACL 审计报告（运行时产物）
.acl_report/
# 只忽略项目根的 memory/（运行时数据）
/memory/
# 迁移脚本每次 --apply 生成的备份（memory.bak-<时间戳>/），不忽略会一直挂在 git status 上
/memory.bak-*/
*.xlsx
*.xls

# IDE
.vscode/
.idea/
*.swp
*.swo

# Mac
.DS_Store

# 临时文件
*.tmp
*.log

# Node
node_modules/
dist/

# Skills 数据文件（会被提交）
# skills/*.md

# pytest 临时输出（本地排查用）
.pytest_*.txt
.pytest_tmp/
.pytest_cache/
.ruff_cache/

# WorkBuddy 工作记忆：跨会话上下文，只属于本机，不入库
