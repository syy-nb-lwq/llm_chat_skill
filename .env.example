# ============================================================================
# Skill Agent - 环境变量示例
# 复制本文件为 .env 并填入实际值:
#   cp .env.example .env   (Linux/Mac)
#   copy .env.example .env (Windows)
# ============================================================================

# ----- LLM Provider 配置 -----
# 默认 Provider: openai / anthropic / local
DEFAULT_PROVIDER=openai

# ----- OpenAI Provider -----
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ----- Anthropic (Claude) Provider -----
# ANTHROPIC_API_KEY=sk-ant-your-api-key-here
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ----- Local (Ollama) Provider -----
LOCAL_BASE_URL=http://localhost:11434
LOCAL_MODEL=llama3.2

# ----- 采样参数 -----
TEMPERATURE=0.7
REQUEST_TIMEOUT_S=60

# ----- 路径(相对项目根) -----
SKILLS_PATH=skills
MEMORY_PATH=memory
VECTOR_PATH=vector_store

# ----- 运行参数 -----
MAX_ITERATIONS=10
SESSION_TTL_S=3600

# ============================================================================
# 工具扩展
# ============================================================================

# ----- MCP 工具源 -----
# 接入 MCP(Model Context Protocol)服务器,拿来现成的工具:
#   文件读写  npx -y @modelcontextprotocol/server-filesystem <目录>
#   网页抓取  npx -y mcp-server-fetch
#   浏览器    npx -y @playwright/mcp
#   Git 操作    uvx mcp-server-git --repository .
#   SQLite       uvx mcp-server-sqlite --db-path ./data.db
#
# 注意:
#   1. MCP 服务器是**第三方进程**(用 npx/uvx 拉),等于引入了
#      第三方代码执行面。**只应由管理员配置**,不要让终端用户自助添加。
#   2. 建议锁定版本(如 @modelcontextprotocol/server-filesystem@2025.6.18)。
#   3. 单个服务器连不上不影响其它的,也不影响启动。
MCP_ENABLED=false
# 格式:数组(可以写多个服务器)。Windows 路径里的反斜杠要想就写想写。
# MCP_SERVERS=[{"name":"filesystem","type":"stdio","server_path":"npx -y @modelcontextprotocol/server-filesystem D:\\workspace"}]
MCP_SERVERS=

# ----- 代码执行(python_exec / write_script / list_scripts)-----
#
# **这是安全开关,不是功能开关。**
# 执行的是 **LLM 生成的代码** —— 它就是任意代码执行面。
#
# 子进程隔离 = **崩溃隔离,不是安全边界**。
# 它能阻止"“LLM 写错代码”和"被诱导写坏代码”,但不阻止
# 有组织的攻击(子进程仍能读到当前用户能读的文件)。
#
# 多租户产品对外开放前:**关掉这个开关**,或者换成容器隔离
# (Docker / gVisor / Firecracker)。
CODE_EXEC_ENABLED=true
CODE_EXEC_TIMEOUT_S=30

# ----- 工具自增长(agent 自己造工具)-----
#
# 打开后 agent 可以用 create_tool 自己造工具:
#   - 声明式 HTTP 工具(给 URL 模板 + 参数)、代码工具(直接写 Python)
#   - **只读工具自动生效**;写操作 / 带密钥的需人工批准
#   - 已发布的工具跨重启保留
#
# 注意代码工具的风险等级**跟 CODE_EXEC_ENABLED 走**——
# 后者开着就意味着 agent 已经能执行任意代码,再多一个代码工具并不扩大攻击面。
# 关掉 CODE_EXEC_ENABLED 后,代码工具会自动需要人工批准。
TOOL_CREATION_ENABLED=true

# ----- 日志 -----
LOG_LEVEL=INFO          # DEBUG / INFO / WARNING / ERROR
LOG_TO_FILE=false
LOG_DIR=logs

# ----- Feature Flags -----
SKILL_DAG_ENABLED=false        # 启用 Skill → DAG 自动执行(实验性)
TOOL_CACHE_ENABLED=false       # 启用工具结果缓存(实验性)
# 自我进化:打开后才会记录成功/失败、生成 SkillPatch,并让「用户纠正 → 重评」
# 这条链真正落盘。纠正**检测**一直都在,但不打开这个开关就只检测不学习。
# 补丁需要人工审批(POST /api/patches/{id}/approve)才会生效。
SELF_EVOLUTION_ENABLED=false   # 启用自我进化(实验性)
MULTI_PROVIDER_ENABLED=false   # 启用多 Provider 支持
SEMANTIC_MEMORY_ENABLED=true   # 启用长期记忆(用户画像)
SOUL_ENABLED=false            # 启用 Soul 身份系统

# ----- Embedding 配置 -----
# 留空 = 不启用向量检索(只用 FTS + CJK 通道 + 画像常驻注入)。
# 只有配了真实 provider 才打开语义通道:
# "mock" 是随机向量(任意两句余弦 ≈ 0.81),拿它做语义检索比不检索更差,
# 所以 `SemanticMemoryStore` 会直接拒绝合成向量。
EMBEDDING_PROVIDER=           # openai / local(留空=不启用)
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_MIN_SIMILARITY=0.35  # 向量通道的最小余弦相似度

# ----- 观测 -----
TRACE_ENABLED=true            # 每轮分阶段耗时落盘(memory/audit/traces.jsonl)

# ----- Soul 配置 -----
SOUL_PATH=soul/SOUL.md
SOUL_ENABLED=false

# ----- Heartbeat 配置 -----
HEARTBEAT_INTERVAL_SECONDS=1800
HEARTBEAT_PATH=heartbeat/HEARTBEAT.md

# ----- MCP 配置 -----
MCP_ENABLED=false
# MCP_SERVERS=[{"name": "github", "command": "npx", "args": ["-y", "@modelcontextprotocol/server-github"]}]

# ----- 认证(C-01)-----
# 管理接口(删除技能 / 审批补丁 / 切换开关等)的 owner token。
# 留空 = 不启用鉴权(单机个人环境的默认行为);
# 填写后,这些接口必须带 "Authorization: Bearer <token>" 请求头。
OWNER_TOKEN=

# 会话令牌签名密钥:服务端给每条 WebSocket 连接签发身份时用的 HMAC 密钥。
# 留空 = 使用进程级随机密钥(进程重启后旧令牌失效,前端会自动重新 init)。
# 多实例部署时必须配置成同一个值,否则跨实例的令牌会校验失败。
SESSION_SECRET=
